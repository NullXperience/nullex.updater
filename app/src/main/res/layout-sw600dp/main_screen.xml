<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".FetchDataActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:gravity="center_vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp">
        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/san_frans_display"
            android:letterSpacing="0.01"
            android:text="@string/app_name"
            android:textColor="#191919"
            android:textSize="30sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingBottom="48dp">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.45"
            android:layout_marginEnd="32dp"
            android:background="@drawable/main_card"
            tools:ignore="NestedWeights">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/main_card" />
            <TextView
                android:id="@+id/verInt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="58dp"
                android:fontFamily="@font/san_frans_pro_display_med"
                android:text="@string/version"
                android:textColor="@android:color/white"
                android:textSize="104sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/san_frans_display"
                android:text="@string/nullexp"
                android:textColor="@android:color/white"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="38dp"
                android:fontFamily="@font/san_frans_display"
                android:textColor="@android:color/white"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/overlayTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="28dp"
                android:fontFamily="@font/san_frans_display"
                android:text="@string/checking"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold" />
        </FrameLayout>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.75"
            android:background="#FFFFFF"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/ThisFragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical" />
            <TextView
                android:id="@+id/no_internet_text"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#ADADAD"
                android:text="@string/no_internet"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>