<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="50dp" />
            <solid android:color="?attr/downloadSolid" />
            <stroke
                android:width="1dp"
                android:color="?attr/downloadStroke" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners
                    android:radius="50dp" />
                <gradient
                    android:angle="0"
                    android:startColor="?attr/downloadCard"
                    android:endColor="?attr/downloadCard" />
                <stroke
                    android:width="1dp"
                    android:color="#60FFFFFF" />
            </shape>
        </clip>
    </item>
</layer-list>