<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_marginTop="40dp"
    android:paddingHorizontal="20dp"
    tools:context=".MainScreenActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="16dp">
        <TextView
            android:id="@+id/appTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_semibold"
            android:letterSpacing="0.01"
            android:text="@string/app_name"
            android:textColor="?attr/otaTextPrim"
            android:textSize="17sp" />
        <ImageView
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_status_dot" />
        <TextView
            android:id="@+id/statusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:text="@string/status_up_to_date"
            android:textColor="?attr/otaAccentDim"
            android:textSize="12sp" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="3dp"
        android:layout_marginStart="2.8dp"
        android:background="@drawable/bg_card_outer">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.02"
                android:text="@string/build_version_label"
                android:textColor="?attr/otaTextMuted"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/verInt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="14dp"
                android:fontFamily="@font/inter"
                android:text="@string/version"
                android:textColor="?attr/otaTextPrim"
                android:textSize="38sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/model"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/bg_pill"
                    android:fontFamily="monospace"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="@string/nullexp"
                    android:textColor="?attr/otaPillText"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/codename"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:fontFamily="monospace"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:textColor="?attr/otaPillText"
                    android:textSize="12sp"
                    tools:text="husky" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginBottom="12dp"
                android:background="?attr/otaBorder" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ProgressBar
                    android:id="@+id/checkingSpinner"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:indeterminateTint="?attr/otaBorder"
                    android:visibility="visible" />
                <TextView
                    android:id="@+id/overlayTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:text="@string/checking"
                    android:textColor="?attr/otaTextSec"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="6dp"
        android:layout_marginStart="6dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/checkUpdateButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="9dp"
            android:background="@drawable/bg_button_primary"
            android:elevation="0dp"
            android:fontFamily="@font/inter_medium"
            android:text="@string/check_for_update"
            android:textAllCaps="false"
            android:textColor="?attr/otaAccentOn"
            android:textSize="14sp" />
        <ImageButton
            android:id="@+id/changelogButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_secondary"
            android:contentDescription="@string/view_changelog"
            android:src="@android:drawable/ic_menu_recent_history"
            app:tint="?attr/otaTextPrim" />
    </LinearLayout>
</LinearLayout>