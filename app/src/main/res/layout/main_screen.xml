<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_marginTop="45dp"
    android:paddingHorizontal="20dp"
    tools:context=".MainScreenActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="16dp">
        <TextView
            android:id="@+id/appTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_semibold"
            android:letterSpacing="0.01"
            android:text="@string/app_name"
            android:textColor="?attr/otaTextPrim"
            android:textSize="17sp" />
        <ImageView
            android:id="@+id/ic_stat"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_status_dot" />
        <TextView
            android:id="@+id/statusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:text="@string/status_up_to_date"
            android:layout_marginBottom="1dp"
            android:textColor="?attr/otaAccentDim"
            android:textSize="12sp" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="3dp"
        android:layout_marginTop="2dp"
        android:layout_marginStart="2.8dp"
        android:background="@drawable/bg_card_outer">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.02"
                android:text="@string/currentdev"
                android:textColor="?attr/otaTextMuted"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/currentDevice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/inter"
                android:textColor="?attr/otaTextPrim"
                android:textSize="38sp"
                android:textStyle="bold"
                tools:text="OnePlus 13s" />
            <TextView
                android:id="@+id/codename"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:fontFamily="monospace"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:layout_marginBottom="20dp"
                android:textColor="?attr/otaPillText"
                android:textSize="12sp"
                tools:text="CPH2723" />
            <View
                android:id="@+id/dividerShit"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginBottom="15dp"
                android:background="?attr/otaBorder" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ProgressBar
                    android:id="@+id/checkingSpinner"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="10dp"
                    android:visibility="visible" />
                <TextView
                    android:id="@+id/overlayTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:text="@string/checking"
                    android:textColor="?attr/otaTextSec"
                    android:textSize="13sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/lastchecked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:textColor="?attr/otaTextSec"
                android:visibility="gone"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/changelogText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter"
                android:lineSpacingExtra="3dp"
                android:textColor="?attr/otaTextSec"
                android:textSize="13sp"
                android:visibility="gone"
                android:text="• Improved system stability&#10;• Improved battery life&#10;• Fixed minor bugs" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/checkForUpdates"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/main_card"
        android:clickable="true"
        android:focusable="true">
        <TextView
            android:id="@+id/checkForUpdatesText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/check_for_update" />
        <ProgressBar
            android:id="@+id/updateProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progressDrawable="@drawable/progress_bar"
            android:visibility="gone" />
    </FrameLayout>
